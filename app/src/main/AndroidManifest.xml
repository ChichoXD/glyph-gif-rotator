<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requerido por el SDK de Nothing para poder controlar la Glyph Matrix -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Servicio en primer plano que mantiene la rotación de GIFs viva -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notificación obligatoria del servicio en primer plano (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reiniciar la rotación automáticamente tras reiniciar el teléfono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pedir al usuario que excluya la app de la optimización de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Saber si GlyphMuseum está en primer plano, para dejarle la Matrix libre -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Detectar cuándo se conecta un dispositivo Bluetooth (auriculares, etc.) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Vibración sincronizada con la animación de captura -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Clima real para las apariciones: Open-Meteo (sin clave) y ubicación aproximada. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphGifRotator">

        <!-- Clave requerida por el SDK de Nothing (com.nothing.ketchum.Common.getAppKey) -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".ui.TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/tutorial_eyebrow" />

        <activity
            android:name=".ui.BalanceActivity"
            android:exported="false"
            android:label="@string/balance_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GlyphRotationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Muestra animaciones GIF en bucle sobre la Glyph Matrix mientras la app esta activa" />
        </service>

        <activity
            android:name=".ui.PokemonActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false"
            android:parentActivityName=".ui.PokemonActivity"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.AchievementsActivity"
            android:exported="false"
            android:parentActivityName=".ui.PokemonActivity"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait" />

        <!-- Glyph Toy registrado para el botón físico: reloj, batería con pulsación larga -->
        <!--
            Sin permiso a propósito: Nothing OS necesita poder enlazar con el toy desde su
            propio proceso para mostrarlo en el carrusel del botón físico. Es el mismo
            patrón que usan el resto de Glyph Toys (incluido glyph-catch). El servicio no
            expone datos: solo dibuja en la Matrix.
        -->
        <service
            android:name=".service.ClockBatteryToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <service
            android:name=".service.MusicSessionListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            La pantalla de decoración, que sale al colocar cualquier widget. exported="true"
            porque quien la lanza es el propio sistema al añadir el widget, no la app.
        -->
        <activity
            android:name=".ui.widget.WidgetDecorActivity"
            android:exported="true"
            android:theme="@style/Theme.GlyphGifRotator"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Los widgets. exported="false" a propósito: el sistema puede colocarlos igual, y así
            ninguna otra app puede dispararles intents (el del agua acepta uno que suma, y
            expuesto sería un botón que cualquiera podría pulsar por ti).
        -->
        <receiver
            android:name=".ui.PokemonWidgetProvider"
            android:exported="false"
            android:label="@string/widget_pokemon_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pokemon_info" />
        </receiver>

        <receiver
            android:name=".ui.WaterWidgetProvider"
            android:exported="false"
            android:label="@string/widget_water_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.PartnerWidget"
            android:exported="false"
            android:label="@string/widget_partner_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_partner_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.EggWidget"
            android:exported="false"
            android:label="@string/widget_egg_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_egg_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.PokedexWidget"
            android:exported="false"
            android:label="@string/widget_pokedex_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pokedex_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.CollectionWidgetProvider"
            android:exported="false"
            android:label="@string/widget_collection_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_collection_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.SleepWidget"
            android:exported="false"
            android:label="@string/widget_sleep_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sleep_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.HabitsWidget"
            android:exported="false"
            android:label="@string/widget_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habits_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.BonusWidget"
            android:exported="false"
            android:label="@string/widget_bonus_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bonus_info" />
        </receiver>

    </application>

</manifest>
