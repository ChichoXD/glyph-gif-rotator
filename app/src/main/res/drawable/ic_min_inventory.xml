<?xml version="1.0" encoding="utf-8"?>
<!--
    Un contenedor rectangular con su asa.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M3.5,8 L20.5,8 L20.5,19 L3.5,19 Z"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M9,8 L9,5.5 L15,5.5 L15,8"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M3.5,12.5 L20.5,12.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
