<?xml version="1.0" encoding="utf-8"?>
<!--
    Un anillo partido en segmentos.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M12,3.5 A8.5,8.5 0 0,1 20.5,12"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M20.5,12 A8.5,8.5 0 0,1 12,20.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12,20.5 A8.5,8.5 0 0,1 3.5,12"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12,12 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="@color/glyph_white" />

</vector>
