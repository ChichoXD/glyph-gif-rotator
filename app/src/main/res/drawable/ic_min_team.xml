<?xml version="1.0" encoding="utf-8"?>
<!--
    Tres módulos en fila, uno destacado.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M3.5,9 L8,9 L8,15 L3.5,15 Z"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M16,9 L20.5,9 L20.5,15 L16,15 Z"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M9.75,8 L14.25,8 L14.25,16 L9.75,16 Z"
        android:fillColor="@color/glyph_white" />

</vector>
