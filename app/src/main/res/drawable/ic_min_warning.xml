<?xml version="1.0" encoding="utf-8"?>
<!--
    Un triángulo con su barra.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M12,4 L21,19.5 L3,19.5 Z"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12,10 L12,14.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12,17 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0"
        android:fillColor="@color/glyph_white" />

</vector>
