<?xml version="1.0" encoding="utf-8"?>
<!--
    Un candado cerrado.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M5,10.5 L19,10.5 L19,20 L5,20 Z"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M8,10.5 L8,7.5 A4,4 0 0,1 16,7.5 L16,10.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
