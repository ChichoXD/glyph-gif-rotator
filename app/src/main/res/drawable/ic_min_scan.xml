<?xml version="1.0" encoding="utf-8"?>
<!--
    Cuatro esquinas y una línea que barre.

    Lienzo de 24, trazo de 1.5 y extremos redondos, como toda la familia. Se tiñe desde
    fuera con app:tint, así que el color de aquí es solo el de por defecto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/glyph_white">

    <path
        android:pathData="M4,8.5 L4,4 L8.5,4"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M15.5,4 L20,4 L20,8.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M20,15.5 L20,20 L15.5,20"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M8.5,20 L4,20 L4,15.5"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M6.5,12 L17.5,12"
        android:strokeColor="@color/glyph_white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
