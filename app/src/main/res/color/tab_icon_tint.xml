<?xml version="1.0" encoding="utf-8"?>
<!--
    El icono de la pestaña: blanco cálido cuando está encendida, gris apagado cuando no.

    Es el mismo par de valores que la Matrix usa para un LED encendido y uno apagado, y esa
    coincidencia es a propósito: la fila de pestañas se lee como el mismo material que la pantalla
    de atrás.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/glyph_led_on" android:state_selected="true" />
    <item android:color="@color/glyph_mute" />
</selector>
