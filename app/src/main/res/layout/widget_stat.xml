<?xml version="1.0" encoding="utf-8"?>
<!--
    El molde de casi todos los widgets: icono y textos arriba, y la barra abajo **cruzando todo
    el ancho**.

    La barra va fuera de la fila del icono a propósito. Metida dentro, empezaba donde terminaba
    el icono y se quedaba en un trocito corto y grueso; suelta y fina, cruzando de lado a lado,
    se lee de un vistazo desde el escritorio sin tener que enfocar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/statIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:contentDescription="@string/widget_decor_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/glyph_grey"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/statValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/glyph_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="@color/glyph_grey"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Segmentos en vez de barra continua: el mismo idioma que la Matrix de atrás. Un widget no
        puede inflar una vista propia, así que el dibujo llega como bitmap desde WidgetSegments
        y esto es un ImageView normal, que sí está permitido en RemoteViews.
    -->
    <ImageView
        android:id="@+id/statProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</LinearLayout>
