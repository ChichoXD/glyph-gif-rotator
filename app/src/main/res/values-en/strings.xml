    <string name="balance_eyebrow">Fine tuning</string>
    <string name="balance_title">Balance</string>
    <string name="balance_intro">What each thing is worth in the normal game and in demo mode. Demo speeds up how often things happen, not how much they reward: the real-life multipliers stay the same on purpose, because inflating those would mean testing a different game.</string>
    <string name="balance_demo_switch">Demo mode</string>
    <string name="balance_state_demo">Demo on · the game runs fast</string>
    <string name="balance_state_normal">Normal pace</string>
    <string name="balance_normal">Normal</string>
    <string name="balance_demo">Demo</string>
    <string name="balance_same">Same</string>
    <string name="balance_minutes">%1$d min</string>
    <string name="balance_hours">%1$d h %2$d min</string>
    <string name="balance_group_spawn">Encounters</string>
    <string name="balance_first_catch">Your first catch</string>
    <string name="balance_first_catch_why">Chance per check while the Pokédex is empty. Deliberately high: waiting an hour to find out whether the game even exists is too much.</string>
    <string name="balance_after_15">After 15 min screen off</string>
    <string name="balance_after_15_why">Checked once a minute. The longer you go without looking at the phone, the higher it climbs.</string>
    <string name="balance_after_30">After 30 min</string>
    <string name="balance_after_30_why">Second step. The counter resets every time one shows up.</string>
    <string name="balance_after_45">After 45 min</string>
    <string name="balance_after_45_why">Third step, now meaningful: this is where leaving the phone alone starts to pay.</string>
    <string name="balance_after_60">After an hour</string>
    <string name="balance_after_60_why">Guaranteed encounter. It is the promise of the game: one hour without looking, one Pokémon for sure.</string>
    <string name="balance_bedtime">Overnight (1:00–7:00)</string>
    <string name="balance_bedtime_why">Cut almost to nothing. Otherwise eight hours of sleep would fill the queue and there would be nothing left to do come morning.</string>
    <string name="balance_group_training">Training</string>
    <string name="balance_exp_minute">Experience per minute</string>
    <string name="balance_exp_minute_why">Only counts with the screen off. It is what your buddy earns while you are not using the phone.</string>
    <string name="balance_level_time">Time per level</string>
    <string name="balance_level_time_why">Uninterrupted screen-off time needed for one level, before the periodic bonus and the real-life multipliers.</string>
    <string name="balance_bonus">Periodic bonus</string>
    <string name="balance_bonus_value">+%1$d every %2$d min</string>
    <string name="balance_bonus_why">A little extra every long stretch of rest, to reward unbroken time over many short gaps. Demo leaves it alone.</string>
    <string name="balance_group_eggs">Eggs</string>
    <string name="balance_captures_egg">Catches per egg</string>
    <string name="balance_captures_egg_why">Eggs stack and are never lost. An egg hatches into a base form, favouring the ones missing from your Pokédex.</string>
    <string name="balance_incubation">Incubation</string>
    <string name="balance_incubation_why">Screen-off minutes it takes to hatch. It competes for the same time as your buddy\'s training.</string>
    <string name="balance_group_life">Real life</string>
    <string name="balance_sleep">Sleep</string>
    <string name="balance_sleep_why">Multiplies experience by how well you slept: hours and how punctual you were going to bed. Sleeping badly genuinely slows you down, not just skips the reward.</string>
    <string name="balance_water">Water</string>
    <string name="balance_water_why">Whether you met today\'s goal. The gentlest of the four: it punishes little and rewards little.</string>
    <string name="balance_habits">Habits</string>
    <string name="balance_habits_why">The widest range. Keeping them all nearly doubles your gain; breaking them all halves it.</string>
    <string name="balance_streak">Streak</string>
    <string name="balance_streak_why">Grows with consecutive days kept, capped at 30 days. The only one that rewards consistency rather than a single good day.</string>
    <string name="balance_total">All together</string>
    <string name="balance_total_why">The four multiply each other. That is the real spread between a terrible day and a perfect one, and it is what to look at when deciding whether things are too easy or too hard.</string>
    <string name="balance_button">Balance and demo mode</string>
