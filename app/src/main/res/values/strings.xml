    <string name="balance_title">Equilibrio</string>
    <string name="balance_intro">Lo que vale cada cosa en el juego normal y en el modo demo. El demo acelera cada cuánto pasan las cosas, no cuánto premian: los multiplicadores de la vida real se quedan igual a propósito, porque si también se inflaran no estarías probando este juego sino otro.</string>
    <string name="balance_demo_switch">Modo demo</string>
    <string name="balance_state_demo">Demo activo · el juego va acelerado</string>
    <string name="balance_state_normal">Ritmo normal</string>
    <string name="balance_normal">Normal</string>
    <string name="balance_demo">Demo</string>
    <string name="balance_same">Igual</string>
    <string name="balance_minutes">%1$d min</string>
    <string name="balance_hours">%1$d h %2$d min</string>
    <string name="balance_group_spawn">Apariciones</string>
    <string name="balance_first_catch">Tu primera captura</string>
    <string name="balance_first_catch_why">Probabilidad por comprobación cuando la Pokédex está vacía. Sube a propósito: esperar una hora para ver si el juego existe siquiera es demasiado.</string>
    <string name="balance_after_15">A los 15 min de pantalla apagada</string>
    <string name="balance_after_15_why">Se comprueba una vez por minuto. Cuanto más tiempo lleves sin mirar el móvil, más sube.</string>
    <string name="balance_after_30">A los 30 min</string>
    <string name="balance_after_30_why">Segundo escalón. El contador se reinicia cada vez que aparece uno.</string>
    <string name="balance_after_45">A los 45 min</string>
    <string name="balance_after_45_why">Tercer escalón, ya notable: aquí es donde empieza a compensar dejar el teléfono.</string>
    <string name="balance_after_60">A la hora</string>
    <string name="balance_after_60_why">Aparición garantizada. Es la promesa del juego: una hora sin mirar el móvil, un Pokémon seguro.</string>
    <string name="balance_bedtime">De madrugada (1:00–7:00)</string>
    <string name="balance_bedtime_why">Se corta casi del todo. Si no, ocho horas de sueño llenarían la cola de capturas y al despertar no quedaría nada por hacer.</string>
    <string name="balance_group_training">Entrenamiento</string>
    <string name="balance_exp_minute">Experiencia por minuto</string>
    <string name="balance_exp_minute_why">Solo cuenta con la pantalla apagada. Es lo que gana el compañero mientras no usas el teléfono.</string>
    <string name="balance_level_time">Tiempo por nivel</string>
    <string name="balance_level_time_why">Pantalla apagada seguida que hace falta para subir un nivel, sin contar el extra ni los multiplicadores de la vida real.</string>
    <string name="balance_bonus">Extra periódico</string>
    <string name="balance_bonus_value">+%1$d cada %2$d min</string>
    <string name="balance_bonus_why">Un pellizco cada rato largo de reposo, para premiar los tramos seguidos frente a muchos ratitos sueltos. El demo no lo toca.</string>
    <string name="balance_group_eggs">Huevos</string>
    <string name="balance_captures_egg">Capturas por huevo</string>
    <string name="balance_captures_egg_why">Los huevos se acumulan y no se pierden. De un huevo sale una forma base, priorizando las que te falten en la Pokédex.</string>
    <string name="balance_incubation">Incubación</string>
    <string name="balance_incubation_why">Minutos de pantalla apagada que tarda en abrirse. Compite por el mismo tiempo que el entrenamiento del compañero.</string>
    <string name="balance_group_life">La vida real</string>
    <string name="balance_sleep">Sueño</string>
    <string name="balance_sleep_why">Multiplica la experiencia según lo bien que dormiste: cantidad y puntualidad al acostarte. Dormir mal frena de verdad, no es solo no ganar el premio.</string>
    <string name="balance_water">Agua</string>
    <string name="balance_water_why">Cumplir el objetivo del día o no. Es el factor más suave de los cuatro: castiga poco y premia poco.</string>
    <string name="balance_habits">Hábitos</string>
    <string name="balance_habits_why">El de mayor recorrido. Cumplirlos todos casi duplica; incumplirlos todos deja la experiencia a la mitad.</string>
    <string name="balance_streak">Racha</string>
    <string name="balance_streak_why">Crece con los días seguidos cumpliendo, hasta el tope a los 30 días. Es el único que premia la constancia y no el día suelto.</string>
    <string name="balance_total">Todos juntos</string>
    <string name="balance_total_why">Los cuatro se multiplican entre sí. Ese es el abanico real entre un día pésimo y uno perfecto, y es lo que hay que mirar para decidir si está fácil o difícil.</string>
    <string name="balance_button">Equilibrio y modo demo</string>
