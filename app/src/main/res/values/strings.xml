    <!-- Los "por qué" de cada objetivo, detrás del icono de información -->
    <string name="info_button">ⓘ</string>
    <string name="info_sleep_title">Sobre el sueño</string>
    <string name="info_sleep_body">Se recomiendan 7–9 h. Por defecto: 7 h 30.\n\nNota = 70 %% cuánto dormiste + 30 %% puntualidad.\n\nSe mide con la pantalla apagada. Cuenta el tramo más largo, no la suma.\n\nNo es consejo médico.</string>
    <string name="info_water_title">Sobre el agua</string>
    <string name="info_water_body">Se suelen citar ~2 L al día, pero depende de ti. Cámbialo.\n\nCada toque suma una ración (un vaso ≈ 250 ml).\n\nEl premio se cobra mañana: así premia el día entero, no un trago de golpe.\n\nNo es consejo médico.</string>
    <string name="info_habits_title">Sobre los hábitos</string>
    <string name="info_habits_body">Los escribes tú: diarios o X veces por semana.\n\nUno semanal se juzga por si vas al ritmo, no por hoy: así el gym no castiga los días de descanso.\n\nRacha en días si es diario, en semanas si es semanal.\n\nIncumplir frena: de ×0,21 a ×2,9.</string>

